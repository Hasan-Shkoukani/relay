# required
OPENAI_API_KEY=your_api_key_here
# required in production so sessions survive restarts: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# set to 1 when served over HTTPS
COOKIE_SECURE=0
PORT=5000

# OpenAI models (vision must accept images; chat must support the web_search tool for the knowledge fallback)
CHAT_MODEL=gpt-5.4-mini
VISION_MODEL=gpt-5.4-mini

# dental model
DENTAL_CONF=0.4
XRAY_MAX_SATURATION=35
# DENTAL_MODEL_PATH=models/dental-yolo26.pt

# per-IP limits
ASKS_PER_MINUTE=30
LOADS_PER_MINUTE=10
